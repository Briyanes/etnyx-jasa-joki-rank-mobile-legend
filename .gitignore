.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db

# Security - never commit these
*.key
*.crt
secrets/
.secrets
.env*.local

# Stale root-level project files (actual project is in /etnyx/)
/src/
/public/
/package.json
/package-lock.json
/next.config.ts
/tsconfig.json
/postcss.config.mjs
/eslint.config.mjs
